# Pin map from CircuitPython's adafruit_qtpy_esp32s3 board definitions (PSRAM and no-PSRAM match).
# No plain LED; the NeoPixel is the indicator. SDA1/SCL1 are the STEMMA QT port.
# A0, A1 and A7 are on ADC2, which can't read while Wi-Fi is busy.
[board]
name    = "qtpy_esp32s3"
chip    = "esp32s3"
title   = "Adafruit QT Py ESP32-S3"
install = "Double-tap RESET for the UF2 drive, then drag uf2-app.bin onto it"
radio   = "wifi ble"
[pins]
NEOPIXEL       = 39
NEOPIXEL_POWER = 38
BUTTON         = 0
A0             = 18
A1             = 17
A2             = 9
A3             = 8
A4             = 7
A5             = 6
A6             = 5
A7             = 16
SDA            = 7
SCL            = 6
SDA1           = 41
SCL1           = 40
TX             = 5
RX             = 16
MOSI           = 35
MISO           = 37
SCK            = 36
[indicators]
NEOPIXEL       = "neopixel power=38"
BUTTON         = "button active_low"
