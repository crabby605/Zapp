# Pin map from CircuitPython's pimoroni_tiny2040 board definition.
[board]
name    = "tiny2040"
chip    = "rp2040"
title   = "Pimoroni Tiny 2040"
install = "Hold the BOOT button and tap RESET"
[pins]
LED_RED        = 18
LED_GREEN      = 19
LED_BLUE       = 20
BUTTON         = 23
A0             = 26
A1             = 27
A2             = 28
A3             = 29
GP0            = 0
GP1            = 1
GP2            = 2
GP3            = 3
GP4            = 4
GP5            = 5
GP6            = 6
GP7            = 7
GP26           = 26
GP27           = 27
GP28           = 28
GP29           = 29
[indicators]
LED_RED        = "led active_low"
LED_GREEN      = "led active_low"
LED_BLUE       = "led active_low"
BUTTON         = "button active_low"
