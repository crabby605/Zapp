# Pin map from CircuitPython's waveshare_rp2040_zero board definition.
# GP16 drives the on-board WS2812, so it isn't listed as a free GPIO.
[board]
name    = "rp2040_zero"
chip    = "rp2040"
title   = "Waveshare RP2040-Zero"
install = "Hold the BOOT button and tap RESET"
[pins]
NEOPIXEL       = 16
A0             = 26
A1             = 27
A2             = 28
A3             = 29
GP0            = 0
GP1            = 1
GP2            = 2
GP3            = 3
GP4            = 4
GP5            = 5
GP6            = 6
GP7            = 7
GP8            = 8
GP9            = 9
GP10           = 10
GP11           = 11
GP12           = 12
GP13           = 13
GP14           = 14
GP15           = 15
GP26           = 26
GP27           = 27
GP28           = 28
GP29           = 29
TX             = 0
RX             = 1
[indicators]
NEOPIXEL       = "neopixel"
