# The LED is wired to the Wi-Fi chip, not a GPIO: 32 is a virtual pin the
# firmware routes to the CYW43's WL_GPIO0 (needs the pico_w build).
# GP23-25 and GP29 belong to the Wi-Fi chip and are deliberately left out.
[board]
name    = "pico_w"
chip    = "rp2040"
title   = "Raspberry Pi Pico W"
install = "Unplug it, hold the white BOOTSEL button, and plug it back in"
radio   = "wifi ble"
[pins]
LED            = 32
A0             = 26
A1             = 27
A2             = 28
GP0            = 0
GP1            = 1
GP2            = 2
GP3            = 3
GP4            = 4
GP5            = 5
GP6            = 6
GP7            = 7
GP8            = 8
GP9            = 9
GP10           = 10
GP11           = 11
GP12           = 12
GP13           = 13
GP14           = 14
GP15           = 15
GP16           = 16
GP17           = 17
GP18           = 18
GP19           = 19
GP20           = 20
GP21           = 21
GP22           = 22
GP26           = 26
GP27           = 27
GP28           = 28
SDA            = 4
SCL            = 5
TX             = 0
RX             = 1
SCK            = 6
MOSI           = 7
MISO           = 8
[indicators]
LED            = "led"
[reserved]
23             = "is wired to the Wi-Fi chip"
24             = "is wired to the Wi-Fi chip"
25             = "is wired to the Wi-Fi chip"
29             = "is wired to the Wi-Fi chip"
